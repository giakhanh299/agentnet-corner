Dialogue: 0,0:00:00.05,0:00:01.19,Default,,0,0,0,,Bạn có biết cửa sổ
Dialogue: 0,0:00:01.23,0:00:02.38,Default,,0,0,0,,máy bay tròn không
Dialogue: 0,0:00:02.42,0:00:03.56,Default,,0,0,0,,phải để đẹp?
Dialogue: 0,0:00:04.86,0:00:06.05,Default,,0,0,0,,Ngày xưa, máy bay
Dialogue: 0,0:00:06.09,0:00:07.29,Default,,0,0,0,,phản lực đầu tiên
Dialogue: 0,0:00:07.33,0:00:08.52,Default,,0,0,0,,ra đời, cửa sổ
Dialogue: 0,0:00:08.56,0:00:09.75,Default,,0,0,0,,vuông vức. Hai năm
Dialogue: 0,0:00:09.79,0:00:10.99,Default,,0,0,0,,sau, hai chiếc vỡ
Dialogue: 0,0:00:11.03,0:00:12.22,Default,,0,0,0,,tan giữa trời.
Dialogue: 0,0:00:13.44,0:00:14.80,Default,,0,0,0,,Điều tra phát hiện
Dialogue: 0,0:00:14.84,0:00:16.19,Default,,0,0,0,,vết nứt bắt đầu
Dialogue: 0,0:00:16.23,0:00:17.59,Default,,0,0,0,,từ một góc nhọn.
Dialogue: 0,0:00:17.63,0:00:18.98,Default,,0,0,0,,Mỗi chuyến bay,
Dialogue: 0,0:00:19.02,0:00:20.38,Default,,0,0,0,,khoang phồng lên
Dialogue: 0,0:00:20.42,0:00:21.78,Default,,0,0,0,,rồi xẹp xuống —
Dialogue: 0,0:00:21.82,0:00:23.17,Default,,0,0,0,,góc nhọn nhân ứng
Dialogue: 0,0:00:23.21,0:00:24.57,Default,,0,0,0,,suất lên nhiều lần,
Dialogue: 0,0:00:24.61,0:00:25.96,Default,,0,0,0,,tới khi kim loại
Dialogue: 0,0:00:26.00,0:00:27.36,Default,,0,0,0,,mỏi và nứt.
Dialogue: 0,0:00:28.74,0:00:29.96,Default,,0,0,0,,Một lỗ tròn nhân
Dialogue: 0,0:00:30.00,0:00:31.21,Default,,0,0,0,,ứng suất lên ba lần,
Dialogue: 0,0:00:31.25,0:00:32.47,Default,,0,0,0,,nhưng góc nhọn nhân
Dialogue: 0,0:00:32.51,0:00:33.73,Default,,0,0,0,,lên gấp hàng chục lần.
Dialogue: 0,0:00:33.77,0:00:34.99,Default,,0,0,0,,Bo tròn góc, ứng
Dialogue: 0,0:00:35.03,0:00:36.24,Default,,0,0,0,,suất trải đều —
Dialogue: 0,0:00:36.28,0:00:37.50,Default,,0,0,0,,và vết nứt hết
Dialogue: 0,0:00:37.54,0:00:38.76,Default,,0,0,0,,chỗ bắt đầu.
Dialogue: 0,0:00:40.04,0:00:41.38,Default,,0,0,0,,Nhìn ra cửa sổ —
Dialogue: 0,0:00:41.42,0:00:42.75,Default,,0,0,0,,bạn đang nhìn một
Dialogue: 0,0:00:42.79,0:00:44.13,Default,,0,0,0,,bài học bằng kim loại.
Dialogue: 0,0:00:44.17,0:00:45.50,Default,,0,0,0,,Bạn có tin không?
Dialogue: 0,0:00:45.54,0:00:46.88,Default,,0,0,0,,Bình luận nhé!
